<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kopi Candu — Sekali Coba, Bikin Candu</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="image_slot.js"></script>
<style>
:root{
  --navy:#0E1B3D;
  --navy-2:#16285A;
  --navy-3:#24397A;
  --yellow:#FFC531;
  --yellow-soft:#FFE9A8;
  --cream:#FFF8EC;
  --white:#FDFCF9;
  --ink:#0E1B3D;
  --muted:#5B6584;
  --line:rgba(14,27,61,.12);
  --caramel:#C7803A;
  --wa:#25D366;
  --display:'Bricolage Grotesque',system-ui,sans-serif;
  --body:'Plus Jakarta Sans',system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--body);color:var(--ink);background:var(--white);-webkit-font-smoothing:antialiased;line-height:1.55}
a{color:inherit;text-decoration:none}
h1,h2,h3{font-family:var(--display);line-height:1.02;letter-spacing:-.02em;text-wrap:balance}
p{text-wrap:pretty}
.wrap{max-width:1200px;margin:0 auto;padding:0 28px}

/* buttons */
.btn{display:inline-flex;align-items:center;gap:10px;font-weight:700;font-size:16px;padding:16px 26px;border-radius:999px;border:0;cursor:pointer;transition:transform .2s cubic-bezier(.3,1.6,.5,1),box-shadow .2s,background .2s}
.btn:hover{transform:translateY(-2px)}
.btn:active{transform:translateY(0) scale(.98)}
.btn-yellow{background:var(--yellow);color:var(--navy);box-shadow:0 6px 0 #D99F12}
.btn-yellow:hover{box-shadow:0 8px 0 #D99F12}
.btn-ghost{background:transparent;color:var(--white);border:2px solid rgba(255,255,255,.3)}
.btn-ghost:hover{border-color:var(--yellow);color:var(--yellow)}
.wa-ico{width:20px;height:20px;flex:none}

/* NAV */
nav{position:sticky;top:0;z-index:50;background:rgba(14,27,61,.92);backdrop-filter:blur(12px);color:var(--white)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:72px}
.logo{font-family:var(--display);font-weight:800;font-size:24px;display:flex;align-items:center;gap:10px;letter-spacing:-.02em}
.logo-mark{width:34px;height:34px;border-radius:50%;background:var(--yellow);display:grid;place-items:center;color:var(--navy);font-size:18px}
.nav-links{display:flex;gap:30px;font-weight:600;font-size:15px}
.nav-links a{opacity:.8;transition:opacity .2s,color .2s}
.nav-links a:hover{opacity:1;color:var(--yellow)}
.nav-cta{padding:11px 20px;font-size:14px;box-shadow:0 4px 0 #D99F12}
@media(max-width:860px){.nav-links{display:none}}

/* HERO */
.hero{background:var(--navy);color:var(--white);position:relative;overflow:hidden;padding:64px 0 120px}
.hero::before{content:"";position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.07) 1.5px,transparent 1.5px);background-size:26px 26px;pointer-events:none}
.hero .wrap{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;position:relative}
.eyebrow{display:inline-flex;align-items:center;gap:8px;background:rgba(255,197,49,.14);color:var(--yellow);font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase;padding:8px 14px;border-radius:999px}
.eyebrow .dot{width:8px;height:8px;border-radius:50%;background:var(--yellow);animation:pulse 1.6s infinite}
@keyframes pulse{50%{opacity:.3}}
.hero h1{font-size:clamp(52px,7.4vw,104px);font-weight:800;margin:22px 0 22px}
.hero h1 .hl{color:var(--yellow);position:relative;white-space:nowrap}
.hero h1 .hl svg{position:absolute;left:0;bottom:-6px;width:100%;height:16px}
.hero p.lead{font-size:19px;color:rgba(253,252,249,.75);max-width:500px}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-top:34px}
.hero-meta{display:flex;gap:34px;margin-top:44px;padding-top:28px;border-top:1px solid rgba(255,255,255,.12)}
.hero-meta b{display:block;font-family:var(--display);font-size:30px;color:var(--yellow);line-height:1}
.hero-meta span{font-size:13px;color:rgba(253,252,249,.6)}
.hero-visual{position:relative}
.hero-visual image-slot{width:100%;aspect-ratio:4/5;display:block;background:var(--navy-2)}
.price-badge{position:absolute;left:-28px;bottom:48px;background:var(--yellow);color:var(--navy);border-radius:50%;width:132px;height:132px;display:grid;place-items:center;text-align:center;transform:rotate(-12deg);box-shadow:0 14px 30px rgba(0,0,0,.25);animation:float 4s ease-in-out infinite}
.price-badge small{display:block;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.price-badge b{font-family:var(--display);font-size:34px;line-height:1}
.hero-tag{position:absolute;right:-14px;top:36px;background:var(--white);color:var(--navy);padding:12px 16px;border-radius:16px;font-weight:700;font-size:14px;box-shadow:0 14px 30px rgba(0,0,0,.25);display:flex;align-items:center;gap:10px;animation:float 4s ease-in-out infinite reverse}
.hero-tag i{font-style:normal;width:30px;height:30px;border-radius:50%;background:var(--yellow-soft);display:grid;place-items:center}
@keyframes float{50%{translate:0 -10px}}
@media(max-width:900px){.hero .wrap{grid-template-columns:1fr}.price-badge{left:10px}.hero-tag{right:10px}}

/* marquee */
.marquee{background:var(--yellow);color:var(--navy);overflow:hidden;transform:rotate(-2deg);margin:-44px -20px 0;position:relative;z-index:2;border-block:3px solid var(--navy)}
.marquee-track{display:flex;gap:40px;padding:16px 0;width:max-content;animation:scroll 30s linear infinite;font-family:var(--display);font-weight:800;font-size:26px;text-transform:uppercase;letter-spacing:-.01em}
.marquee-track span{display:flex;align-items:center;gap:40px;white-space:nowrap}
.marquee-track span::after{content:"✦";font-size:20px}
@keyframes scroll{to{transform:translateX(-50%)}}

/* SECTION BASE */
section{padding:110px 0}
.sec-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:52px;flex-wrap:wrap}
.kicker{font-weight:700;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--caramel);margin-bottom:14px;display:block}
.sec-head h2{font-size:clamp(38px,5vw,64px);font-weight:800;max-width:640px}
.sec-head p{max-width:380px;color:var(--muted);font-size:17px}

/* VALUES */
.values{background:var(--white)}
.val-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.val{background:var(--cream);border-radius:28px;padding:30px 26px 32px;position:relative;transition:transform .3s,background .3s,color .3s;border:1.5px solid var(--line)}
.val:hover{transform:translateY(-6px);background:var(--navy);color:var(--white)}
.val:hover p{color:rgba(253,252,249,.7)}
.val-num{font-family:var(--display);font-weight:800;font-size:15px;color:var(--caramel)}
.val-ico{width:58px;height:58px;border-radius:18px;background:var(--yellow);display:grid;place-items:center;font-size:26px;margin:26px 0 24px;color:var(--navy)}
.val h3{font-size:24px;font-weight:700;margin-bottom:10px}
.val p{color:var(--muted);font-size:15px;transition:color .3s}
.val.feature{background:var(--yellow);border-color:var(--yellow)}
.val.feature .val-ico{background:var(--navy);color:var(--yellow)}
.val.feature .big{font-family:var(--display);font-weight:800;font-size:44px;line-height:1;margin-bottom:6px}
@media(max-width:960px){.val-grid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.val-grid{grid-template-columns:1fr}}

/* MENU */
.menu{background:var(--cream);position:relative}
.tabs{display:inline-flex;background:var(--white);border:1.5px solid var(--line);padding:6px;border-radius:999px;position:relative}
.tab{position:relative;z-index:1;border:0;background:none;font:700 16px var(--body);color:var(--muted);padding:13px 28px;border-radius:999px;cursor:pointer;transition:color .25s;display:flex;align-items:center;gap:8px}
.tab .count{font-size:12px;background:rgba(14,27,61,.08);padding:2px 8px;border-radius:99px;transition:background .25s}
.tab.active{color:var(--white)}
.tab.active .count{background:var(--yellow);color:var(--navy)}
.tab-pill{position:absolute;top:6px;bottom:6px;left:6px;background:var(--navy);border-radius:999px;transition:all .35s cubic-bezier(.4,1.3,.5,1)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:22px}
.card{background:var(--white);border-radius:26px;padding:12px;border:1.5px solid var(--line);display:flex;flex-direction:column;transition:transform .3s,box-shadow .3s;animation:cardIn .5s both}
.card:hover{transform:translateY(-6px);box-shadow:0 22px 40px -18px rgba(14,27,61,.35)}
@keyframes cardIn{from{opacity:0;transform:translateY(18px)}}
.card-img{position:relative}
.card image-slot{width:100%;aspect-ratio:1/1;display:block;background:var(--yellow-soft)}
.card.nonkopi image-slot{background:#DCE4F7}
.card-tag{position:absolute;top:12px;left:12px;background:var(--navy);color:var(--yellow);font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:6px 10px;border-radius:99px;pointer-events:none;z-index:2}
.card-body{padding:18px 10px 8px;display:flex;flex-direction:column;flex:1}
.card h3{font-size:22px;font-weight:700;letter-spacing:-.01em}
.card .desc{font-size:14px;color:var(--muted);margin:6px 0 18px;flex:1}
.card-foot{display:flex;align-items:center;justify-content:space-between;gap:10px}
.price{font-family:var(--display);font-weight:800;font-size:24px}
.price small{font-size:14px;font-weight:700;color:var(--muted);margin-right:2px}
.order{display:inline-flex;align-items:center;gap:7px;background:var(--navy);color:var(--white);font-weight:700;font-size:13px;padding:11px 14px;border-radius:99px;transition:background .2s,color .2s}
.order:hover{background:var(--yellow);color:var(--navy)}
.order .wa-ico{width:16px;height:16px}

/* TESTIMONI */
.testi{background:var(--navy);color:var(--white);overflow:hidden}
.testi .kicker{color:var(--yellow)}
.testi .sec-head p{color:rgba(253,252,249,.65)}
.rating-big{display:flex;align-items:center;gap:16px}
.rating-big b{font-family:var(--display);font-size:64px;font-weight:800;color:var(--yellow);line-height:1}
.stars{color:var(--yellow);letter-spacing:2px;font-size:16px}
.t-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.t-card{background:var(--navy-2);border:1.5px solid rgba(255,255,255,.08);border-radius:26px;padding:28px;display:flex;flex-direction:column;gap:20px;transition:transform .3s,border-color .3s}
.t-card:hover{transform:translateY(-4px);border-color:var(--yellow)}
.t-card.hl{background:var(--yellow);color:var(--navy)}
.t-card.hl .stars{color:var(--navy)}
.t-card.hl .who small{color:rgba(14,27,61,.65)}
.t-card blockquote{font-size:17px;line-height:1.55;flex:1}
.t-card.big blockquote{font-family:var(--display);font-size:26px;font-weight:700;line-height:1.2;letter-spacing:-.01em}
.who{display:flex;align-items:center;gap:12px}
.avatar{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;font-weight:800;font-family:var(--display);background:var(--yellow);color:var(--navy);flex:none}
.t-card.hl .avatar{background:var(--navy);color:var(--yellow)}
.who b{display:block;font-size:15px}
.who small{color:rgba(253,252,249,.55);font-size:13px}
.t-card.big{grid-row:span 2}
@media(max-width:960px){.t-grid{grid-template-columns:1fr 1fr}.t-card.big{grid-row:auto;grid-column:span 2}}
@media(max-width:600px){.t-grid{grid-template-columns:1fr}.t-card.big{grid-column:auto}}

/* LOKASI */
.loc-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:22px}
.loc-info{display:flex;flex-direction:column;gap:18px}
.info-box{border-radius:26px;padding:28px;border:1.5px solid var(--line);background:var(--cream)}
.info-box.hours{background:var(--yellow);border-color:var(--yellow)}
.info-label{font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;opacity:.7;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center}
.status{font-size:12px;letter-spacing:.04em;padding:5px 11px;border-radius:99px;background:var(--navy);color:var(--white);opacity:1;display:inline-flex;gap:6px;align-items:center}
.status i{width:7px;height:7px;border-radius:50%;background:#ff6b6b}
.status.open i{background:var(--wa)}
.hours-big{font-family:var(--display);font-weight:800;font-size:clamp(44px,5vw,60px);line-height:1;letter-spacing:-.03em}
.hours-big span{font-size:20px;letter-spacing:0}
.info-box p.addr{font-size:19px;font-weight:600;line-height:1.45}
.loc-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}
.btn-navy{background:var(--navy);color:var(--white);padding:13px 20px;font-size:14px}
.btn-navy:hover{background:var(--navy-3)}
.btn-line{background:transparent;border:1.5px solid var(--navy);color:var(--navy);padding:12px 20px;font-size:14px}
.map{border-radius:26px;overflow:hidden;border:1.5px solid var(--line);position:relative;min-height:440px;background:#E8ECF4}
.map iframe{position:absolute;inset:0;width:100%;height:100%;border:0;filter:saturate(.85)}
.map-chip{position:absolute;left:16px;bottom:16px;background:var(--navy);color:var(--white);padding:12px 16px;border-radius:16px;font-weight:700;font-size:14px;display:flex;align-items:center;gap:10px;box-shadow:0 10px 24px rgba(14,27,61,.3)}
.map-chip:hover{background:var(--navy-3)}
.map-chip i{font-style:normal;color:var(--yellow)}
@media(max-width:900px){.loc-grid{grid-template-columns:1fr}}

/* CTA BANNER */
.cta-band{padding:0 0 110px}
.cta-inner{background:var(--yellow);border-radius:36px;padding:64px;display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center;position:relative;overflow:hidden}
.cta-inner::after{content:"CANDU";position:absolute;right:-20px;bottom:-60px;font-family:var(--display);font-weight:800;font-size:220px;color:rgba(14,27,61,.06);letter-spacing:-.04em;pointer-events:none}
.cta-inner h2{font-size:clamp(36px,4.6vw,58px);font-weight:800;max-width:640px}
.cta-inner p{margin-top:12px;font-size:17px;color:rgba(14,27,61,.75)}
.cta-inner .btn{background:var(--navy);color:var(--white);box-shadow:0 6px 0 #050B1D;position:relative;z-index:1}
@media(max-width:760px){.cta-inner{grid-template-columns:1fr;padding:40px 28px}}

/* FOOTER */
footer{background:var(--navy);color:var(--white);padding:80px 0 36px}
.foot-top{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px;padding-bottom:50px;border-bottom:1px solid rgba(255,255,255,.12)}
.foot-top p{color:rgba(253,252,249,.6);margin-top:16px;max-width:320px;font-size:15px}
.foot-col h4{font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--yellow);margin-bottom:18px}
.contact{display:flex;align-items:center;gap:12px;padding:12px 0;font-weight:600;transition:color .2s}
.contact:hover{color:var(--yellow)}
.contact .c-ico{width:40px;height:40px;border-radius:12px;background:var(--navy-2);display:grid;place-items:center;flex:none}
.contact small{display:block;font-weight:500;font-size:12px;color:rgba(253,252,249,.5)}
.foot-col ul{list-style:none}
.foot-col li a{display:block;padding:7px 0;color:rgba(253,252,249,.75);transition:color .2s}
.foot-col li a:hover{color:var(--yellow)}
.foot-bottom{display:flex;justify-content:space-between;padding-top:28px;font-size:13px;color:rgba(253,252,249,.45);flex-wrap:wrap;gap:10px}
.foot-giant{font-family:var(--display);font-weight:800;font-size:clamp(80px,17vw,230px);letter-spacing:-.05em;line-height:.85;color:var(--navy-2);margin-top:40px;text-align:center;user-select:none}
.foot-giant span{color:var(--yellow)}
@media(max-width:800px){.foot-top{grid-template-columns:1fr}}

/* FLOATING WA */
.float-wa{position:fixed;right:24px;bottom:24px;z-index:100;display:flex;align-items:center;gap:0;background:var(--wa);color:#fff;border-radius:999px;height:64px;padding:0 20px;box-shadow:0 12px 30px rgba(37,211,102,.45);font-weight:700;transition:gap .3s,padding .3s}
.float-wa .wa-ico{width:26px;height:26px}
.float-wa .lbl{max-width:0;overflow:hidden;white-space:nowrap;transition:max-width .35s}
.float-wa:hover{gap:10px}
.float-wa:hover .lbl{max-width:200px}
.float-wa::before{content:"";position:absolute;inset:0;border-radius:inherit;background:var(--wa);z-index:-1;animation:ring 2s infinite}
@keyframes ring{from{transform:scale(1);opacity:.6}to{transform:scale(1.5);opacity:0}}
.float-wa .bubble{position:absolute;right:0;bottom:78px;background:var(--white);color:var(--navy);padding:12px 16px;border-radius:16px 16px 4px 16px;font-size:14px;white-space:nowrap;box-shadow:0 10px 30px rgba(14,27,61,.2);animation:bubble 6s 2s both}
@keyframes bubble{0%{opacity:0;transform:translateY(8px)}8%,85%{opacity:1;transform:none}100%{opacity:0;transform:translateY(8px);visibility:hidden}}

/* reveal */
.reveal{opacity:0;transform:translateY(28px);transition:opacity .7s,transform .7s cubic-bezier(.2,.8,.2,1)}
.reveal.in{opacity:1;transform:none}
</style>
</head>
<body>

