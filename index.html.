</svg>

<!-- NAV -->
<nav>
  <div class="wrap">
    <a href="#top" class="logo"><span class="logo-mark">☕</span>Kopi Candu</a>
    <div class="nav-links">
      <a href="#kenapa">Kenapa Kami</a>
      <a href="#menu">Menu</a>
      <a href="#ulasan">Ulasan</a>
      <a href="#lokasi">Lokasi</a>
    </div>
    <a class="btn btn-yellow nav-cta wa-link" data-msg="Halo Kopi Candu! Mau pesan dong 🙌"><svg class="wa-ico"><use href="#wa"/></svg>Pesan</a>
  </div>
</nav>

<!-- HERO -->
<header class="hero" id="top" data-screen-label="01 Hero">
  <div class="wrap">
    <div>
      <span class="eyebrow"><span class="dot"></span>Buka setiap hari · 15.00–18.30</span>
      <h1>Sekali seruput, <span class="hl">auto candu.<svg viewBox="0 0 300 16" preserveAspectRatio="none"><path d="M3 12 C 80 2, 200 2, 297 9" stroke="#FFC531" stroke-width="5" fill="none" stroke-linecap="round"/></svg></span></h1>
      <p class="lead">Kopi &amp; non-kopi kekinian dari Lebaksiu, Tegal. Creamy, manisnya pas, harganya ramah buat dompet pelajar — mulai Rp 7.000 aja.</p>
      <div class="hero-ctas">
        <a class="btn btn-yellow wa-link" data-msg="Halo Kopi Candu! Saya mau pesan, boleh minta info menu hari ini? ☕"><svg class="wa-ico"><use href="#wa"/></svg>Pesan via WhatsApp</a>
        <a href="#menu" class="btn btn-ghost">Lihat Menu →</a>
      </div>
      <div class="hero-meta">
        <div><b>10</b><span>Varian menu</span></div>
        <div><b>7rb</b><span>Harga mulai</span></div>
        <div><b>4.9★</b><span>Kata pelanggan</span></div>
      </div>
    </div>
