<script>
const WA = '6285603974619';
const waUrl = msg => `https://wa.me/${WA}?text=${encodeURIComponent(msg)}`;

const MENU = {
  kopi: [
    {n:'Spanish Latte', p:12000, d:'Espresso, susu segar & susu kental manis. Creamy, manis legit.', tag:'Best Seller'},
    {n:'Coffee Latte', p:10000, d:'Klasik dan lembut. Espresso berpadu susu yang smooth.'},
    {n:'Kopiko Latte', p:10000, d:'Rasa permen kopi favorit, versi latte dingin yang nagih.', tag:'Unik'},
    {n:'Kopi Susu Creamy', p:12000, d:'Kopi susu dengan tekstur ekstra creamy di setiap seruput.'},
    {n:'Kopi Susu Gula Aren', p:12000, d:'Gula aren asli, wangi karamel alami yang khas.', tag:'Favorit'},
    {n:'Americano', p:7000, d:'Bold, clean, tanpa basa-basi. Buat pecinta kopi murni.', tag:'Termurah'},
    {n:'Brown Sugar Kopi Latte', p:12000, d:'Sirup brown sugar karamel berlapis kopi & susu.'},
  ],
  nonkopi: [
    {n:'Matcha Latte', p:13000, d:'Matcha lembut, tidak pahit, dengan susu segar.', tag:'Hits'},
    {n:'Milo Lava', p:12000, d:'Milo kental dengan topping Milo yang lumer. Cokelat banget!', tag:'Best Seller'},
    {n:'Signature Chocolate', p:12000, d:'Cokelat premium racikan khas Kopi Candu. Rich & creamy.'},
  ]
};
const rp = n => n.toLocaleString('id-ID');
const waSvg = '<svg class="wa-ico"><use href="#wa"/></svg>';

function slug(s){return s.toLowerCase().replace(/[^a-z0-9]+/g,'-')}
function render(cat){
  const g = document.getElementById('grid');
  g.innerHTML = MENU[cat].map((m,i)=>`
    <article class="card ${cat}" style="animation-delay:${i*60}ms">
      <div class="card-img">
        ${m.tag?`<span class="card-tag">${m.tag}</span>`:''}
        <image-slot id="menu-${slug(m.n)}" shape="rounded" radius="18" placeholder="Foto ${m.n}"></image-slot>
      </div>
      <div class="card-body">
        <h3>${m.n}</h3>
        <p class="desc">${m.d}</p>
        <div class="card-foot">
          <span class="price"><small>Rp</small>${rp(m.p)}</span>
          <a class="order" href="${waUrl(`Halo Kopi Candu! Saya mau order *${m.n}* (Rp ${rp(m.p)}) 1 cup ya ☕`)}" target="_blank" rel="noopener">${waSvg}Order</a>
        </div>
      </div>
    </article>`).join('');
}

// tabs
const tabs = [...document.querySelectorAll('.tab')], pill = document.getElementById('pill');
function movePill(t){pill.style.width=t.offsetWidth+'px';pill.style.transform=`translateX(${t.offsetLeft-6}px)`}
tabs.forEach(t=>t.addEventListener('click',()=>{
  tabs.forEach(x=>x.classList.toggle('active',x===t));
  movePill(t); render(t.dataset.cat);
  localStorage.setItem('kc-tab',t.dataset.cat);
}));
const saved = localStorage.getItem('kc-tab')||'kopi';
const startTab = tabs.find(t=>t.dataset.cat===saved)||tabs[0];
tabs.forEach(x=>x.classList.toggle('active',x===startTab));
render(startTab.dataset.cat);
document.fonts.ready.then(()=>movePill(startTab));
addEventListener('resize',()=>movePill(document.querySelector('.tab.active')));

// wa links
document.querySelectorAll('.wa-link').forEach(a=>{a.href=waUrl(a.dataset.msg||'Halo Kopi Candu!');a.target='_blank';a.rel='noopener'});

// marquee
const words=['Spanish Latte','Kopi Susu Gula Aren','Matcha Latte','Milo Lava','Americano 7rb','Brown Sugar Latte','Signature Chocolate'];
const half=words.map(w=>`<span>${w}</span>`).join('');
document.getElementById('marquee').innerHTML=half+half;

// open status (WIB = UTC+7)
(function(){
  const now=new Date(), wib=new Date(now.getTime()+(now.getTimezoneOffset()+420)*60000);
  const m=wib.getHours()*60+wib.getMinutes(), open=m>=900&&m<1110;
  const s=document.getElementById('status');
  s.classList.toggle('open',open);
  s.querySelector('em').textContent=open?'Sedang buka':'Tutup sekarang';
})();

// reveal
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll('.reveal').forEach((el,i)=>{el.style.transitionDelay=(i%4)*80+'ms';io.observe(el)});
</script>
